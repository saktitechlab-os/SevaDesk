{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SevaDesk",
  "version": "1.0.0",
  "identifier": "com.sevadesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SevaDesk - Hindi Typing & Forms Library",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}